# URL of the Android companion app's local HTTP bridge (see mcp-google-health/README.md).
HEALTH_BRIDGE_URL=http://127.0.0.1:8787

# API key shown in the Android app's UI, used to authenticate this server to the phone.
HEALTH_BRIDGE_API_KEY=

# Long random string. Required once you tunnel this server publicly (e.g. via ngrok),
# so anyone who finds the URL can't read your health data.
MCP_API_KEY=

# Comma-separated hostnames this server will accept requests for, beyond localhost.
# Set this to your tunnel's hostname (no scheme), e.g. mcp.yourdomain.com (Cloudflare
# named tunnel, recommended) or abcd1234.trycloudflare.com / abcd1234.ngrok-free.app
# (quick tunnels).
MCP_ALLOWED_HOSTS=

# Port for the MCP server itself.
PORT=3200
