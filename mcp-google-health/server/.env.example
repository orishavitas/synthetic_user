# Set automatically when you add the Neon Postgres integration in the Vercel dashboard
# (Storage tab). For local `vercel dev`, pull it with `vercel env pull`.
DATABASE_URL=

# Long random string. Protects /api/mcp — this is what Claude's connector authenticates with.
MCP_API_KEY=

# A different long random string. Protects /api/sync — this is what the Android app
# authenticates with when it uploads a Health Connect snapshot.
SYNC_API_KEY=
