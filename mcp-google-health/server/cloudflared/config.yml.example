# Named Cloudflare Tunnel config — gives you a PERMANENT URL that survives restarts,
# unlike ngrok's free tier or cloudflared's "quick tunnel" mode.
#
# Prerequisites: you own a domain and it's added to your (free) Cloudflare account.
#
# Setup (run once):
#   cloudflared tunnel login
#   cloudflared tunnel create health-mcp
#   cloudflared tunnel route dns health-mcp mcp.yourdomain.com
#
# Then copy this file to config.yml (fill in the values below) and run:
#   cloudflared tunnel run health-mcp

tunnel: health-mcp
credentials-file: /home/YOUR_USER/.cloudflared/<TUNNEL_ID>.json

ingress:
  - hostname: mcp.yourdomain.com
    service: http://localhost:3200
  - service: http_status:404
